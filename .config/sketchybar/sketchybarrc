#!/bin/bash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SketchyBar — Vesper, notch black (peach + mint on #000, no border)
#   left:   1 2 3 (4) 5 6  kitty  ~/git/fraktas   (focused workspace = peach pill)
#   right: cpu ▬▭ mem ▬▬▭ 󰖩 󰁹 82% wed 30 sep 14:32
# Previous Tokyo Night bar: dotfiles tag sketchybar-tokyo-night (see ~/README.md)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"

FONT="Martian Mono"
ICON_FONT="Hack Nerd Font"

# ── Bar Appearance ──────────────────────────────────
# notch_display_height: on the built-in screen the bar matches the notch
# (32pt on this 16" MacBook), so it ends exactly where the notch does.
# Other displays keep height=30.
# shadow MUST stay off: in sketchybar 2.24.0 shadow=on causes shadow flicker
# in other windows. Upstream: https://github.com/FelixKratz/SketchyBar/issues/827
sketchybar --bar \
  position=top \
  height=30 \
  notch_display_height=32 \
  color=$BAR_COLOR \
  border_color=$BAR_BORDER \
  border_width=0 \
  blur_radius=0 \
  shadow=off \
  sticky=on \
  padding_left=14 \
  padding_right=14 \
  topmost=window

# ── Defaults ────────────────────────────────────────
# Type scale: text Martian Mono 10pt (date + time 11pt), Nerd Font glyphs
# 13pt (Apple logo 15pt).
# Colour roles: status items on the right are one grey (MUTED): text, glyphs
# and meters, except the date in light grey. PEACH only marks focus
# (workspace pill) and the time. RED only
# warns (cpu/mem over threshold, low battery).
default=(
  padding_left=0
  padding_right=0
  icon.drawing=off
  icon.font="$FONT:Std Rg:10.0"
  icon.color=$MUTED
  label.font="$FONT:Std Rg:10.0"
  label.color=$FG
  label.padding_left=0
  label.padding_right=0
  background.drawing=off
  popup.background.color=$POPUP_BG
  popup.background.corner_radius=6
  popup.background.border_color=$POPUP_BORDER
  popup.background.border_width=1
  updates=on
)
sketchybar --default "${default[@]}"

# ── Events ──────────────────────────────────────────
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

# ── Left: Apple menu, workspaces, then focused app + window title ──
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

# ── Right (added right to left): time + date, battery, internet, mem, cpu ──
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/ram.sh"
source "$ITEM_DIR/cpu.sh"

# ── Force Initial Update ───────────────────────────
sketchybar --update
